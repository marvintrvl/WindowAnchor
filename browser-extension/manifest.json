{
  "manifest_version": 3,
  "name": "WindowAnchor Browser Connector",
  "version": "0.1.0",
  "description": "Captures and restores browser tabs for WindowAnchor workspaces.",
  "permissions": ["tabs", "tabGroups", "nativeMessaging"],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "WindowAnchor Browser Connector",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}