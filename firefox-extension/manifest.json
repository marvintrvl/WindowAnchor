{
  "manifest_version": 2,
  "name": "WindowAnchor Browser Connector",
  "version": "0.1.0",
  "description": "Captures and restores Firefox tabs for WindowAnchor workspaces.",
  "homepage_url": "https://github.com/marvintrvl/WindowAnchor",
  "permissions": ["tabs", "tabGroups", "storage", "nativeMessaging"],
  "incognito": "not_allowed",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "WindowAnchor Browser Connector",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "windowanchor-browser-connector@windowanchor.app",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent",
          "personallyIdentifyingInfo"
        ]
      }
    }
  }
}
